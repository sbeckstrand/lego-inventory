# Copy this file to .env and fill in your values.

# Rebrickable API key (free). Create an account, then generate a key at:
#   https://rebrickable.com/users/<you>/settings/#api
REBRICKABLE_API_KEY=

# --- Overrides (optional in local dev; compose provides sane defaults) ---

# Point at your own Postgres server in prod, e.g.
#   postgresql+psycopg://user:pass@postgres.lan:5432/lego
# DATABASE_URL=postgresql+psycopg://lego:lego@db:5432/lego

# Where set images are cached. In k8s this is the NFS mount path.
# ASSETS_DIR=/data/assets
